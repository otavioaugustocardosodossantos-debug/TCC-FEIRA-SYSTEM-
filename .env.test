# Ambiente usado SÓ pelos testes automatizados (npm test).
# Aponta pra um banco separado (feira_system_test), nunca o de desenvolvimento
# ou produção — os testes apagam e recriam esse banco a cada execução.
#
# Este arquivo NÃO tem segredo real nenhum (senha de teste local, chave JWT
# declaradamente falsa) — por isso, ao contrário do .env, ele é versionado
# junto com o projeto, pra "npm test" funcionar de primeira em qualquer
# máquina sem precisar de configuração extra.

PORT=3001
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=1234
DB_NAME=feira_system_test
JWT_SECRET=segredo-de-teste-nao-usar-em-producao-de-verdade
FRONTEND_URL=http://localhost:5173

# Limite de tentativas de login bem alto nos testes, senão os próprios
# testes automatizados disparam o rate limiting e derrubam uns aos outros.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=100000
